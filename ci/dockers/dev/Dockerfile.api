FROM node:20-alpine
# 헬스체크(docker-compose)에서 curl 을 사용하므로 alpine 에 설치한다.
# vips-tools/vips-heif: HEIC 변환용 (job-053). sharp 번들 libvips 는 HEVC 디코더가 없어
# HEIC 를 못 읽는다 — prod Dockerfile 의 같은 줄에 자세한 이유가 있다.
RUN apk add --no-cache curl vips-tools vips-heif
RUN npm install -g pnpm

WORKDIR /app

# 1. 루트의 필수 파일 복사
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# 2. 모든 소스 코드를 폴더 구조 그대로 복사
COPY apps ./apps
COPY packages ./packages
COPY package.json ./package.json
COPY tsconfig.base.json ./tsconfig.base.json
COPY tsconfig.json ./tsconfig.json

ARG DATABASE_URL
ENV DATABASE_URL=$DATABASE_URL

# 3. 설치 (루트에서 실행하면 workspace 전체 의존성이 다 설치됨)
RUN pnpm install

CMD ["pnpm", "--filter", "api", "start:dev"]
