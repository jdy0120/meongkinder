FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS builder
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

# api 빌드 (turbo가 의존성 그래프를 읽어 database db:generate → database build →
# shared build → api build 순서를 자동으로 보장)
RUN pnpm turbo run build --filter=api

# 배포를 위해 필요한 파일만 추출 (/app/pruned 폴더로)
# production 의존성만 포함됩니다.
RUN pnpm --filter api --prod deploy /app/pruned --legacy

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

# pruned 폴더의 결과물만 복사
COPY --from=builder /app/pruned ./

COPY --from=builder /app/packages/database/prisma ./prisma/prisma
COPY --from=builder /app/packages/database/prisma.config.ts ./prisma/prisma.config.ts

# 기본 포트 설정 (사용자 요청에 맞춤)
EXPOSE 3000
ENV PORT=${SERVER_PORT:-4174}

CMD ["sh", "-c", "cd ./prisma && node ../node_modules/.pnpm/node_modules/prisma/build/index.js db push --schema=./prisma --accept-data-loss && cd .. && node dist/src/main.js"]