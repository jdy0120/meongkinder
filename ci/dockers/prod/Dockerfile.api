FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# 1) Pruner: 모노레포에서 api 서브셋(api + 의존 패키지)만 추출한다.
#    out/json  = package.json + lockfile (install 레이어 캐싱용)
#    out/full  = 실제 소스 (build 레이어용)
FROM base AS pruner
WORKDIR /app
RUN npm install -g turbo@2.10.3
COPY . .
RUN turbo prune api --docker

# 2) Builder: 의존성 설치 → 소스 복사 → 빌드
FROM base AS builder
WORKDIR /app
# 매니페스트/lockfile 만 먼저 복사해 install 을 별도 레이어로 캐싱한다.
# (소스만 바뀌고 의존성이 그대로면 pnpm install 레이어가 재사용된다)
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile

# 실제 소스 복사 후 빌드 (turbo가 database db:generate → database build →
# shared build → api build 순서를 자동으로 보장)
COPY --from=pruner /app/out/full/ .
# turbo prune 는 루트 공용 tsconfig 를 포함하지 않으므로 별도 복사한다 (모든 패키지가 extends).
COPY tsconfig.base.json ./tsconfig.base.json
RUN pnpm turbo run build --filter=api

# 배포를 위해 production 의존성만 추출 (/app/pruned 폴더로)
RUN pnpm --filter api --prod deploy /app/pruned --legacy

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

# job-053: HEIC(아이폰 기본 촬영 포맷) 변환용 libvips.
#
# sharp 에 번들된 libvips 로는 HEIC 를 **디코딩할 수 없다** — HEVC(H.265) 디코더가
# 특허 라이선스 때문에 빠져 있어서, `sharp.format.heif.input.fileSuffix` 가 [".avif"] 뿐이다.
# (`SHARP_FORCE_GLOBAL_LIBVIPS=1` 도 시도했지만 alpine 의 libvips 8.17.3 이 sharp 0.35 의
#  요구 버전에 못 미쳐 번들 라이브러리로 되돌아간다.)
#
# 그래서 HEIC 만 `vips` CLI 를 자식 프로세스로 호출해 처리한다. 자식 프로세스라
# Node 이벤트 루프를 막지 않는다 — 변환 중에도 API 는 다른 요청을 정상 처리한다.
# 동시 실행 수는 IMAGE_CONVERT_CONCURRENCY 로 제한한다(아래 파일 유틸 주석 참고).
RUN apk add --no-cache vips-tools vips-heif

# pruned 폴더의 결과물만 복사
COPY --from=builder /app/pruned ./

COPY --from=builder /app/packages/database/prisma ./prisma/prisma
COPY --from=builder /app/packages/database/prisma.config.ts ./prisma/prisma.config.ts

# 기본 포트 설정 (사용자 요청에 맞춤)
EXPOSE 3000
ENV PORT=${SERVER_PORT:-4174}

# 시작 시 미적용 마이그레이션을 적용(migrate deploy) 후 서버 기동.
# db push(스키마 강제 동기화)와 달리 마이그레이션 이력 기반이라 안전하고 재현 가능.
CMD ["sh", "-c", "cd ./prisma && node ../node_modules/.pnpm/node_modules/prisma/build/index.js migrate deploy --schema=./prisma && cd .. && node dist/src/main.js"]
