FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS builder
WORKDIR /app
COPY . .

ARG API_BASE_URL
ARG NEXT_PUBLIC_API_BASE_URL

ENV API_BASE_URL=${API_BASE_URL}
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}

# Next.js 빌드를 위해 워크스페이스 의존성 모두 맵핑
RUN pnpm install --frozen-lockfile

# admin 빌드 (turbo가 의존성 그래프를 읽어 database db:generate → database build →
# shared build → admin build 순서를 자동으로 보장)
RUN pnpm turbo run build --filter=admin

FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Next.js Standalone 결과물 복사
# Standalone 모드는 빌드된 코드와 node_modules 일부분을 모아서 내보냅니다.
COPY --from=builder /app/apps/admin/public ./apps/admin/public
COPY --from=builder /app/apps/admin/.next/standalone ./
COPY --from=builder /app/apps/admin/.next/static ./apps/admin/.next/static

EXPOSE 3000

ENV PORT=${ADMIN_PORT:-3333}
ENV HOSTNAME="0.0.0.0"

# Standalone은 apps/admin/server.js를 떨굽니다.
CMD ["node", "apps/admin/server.js"]

