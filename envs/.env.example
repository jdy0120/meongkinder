# =============================================================================
# .env.example — 이 파일을 복사해서 환경별 파일을 만드세요.
#   cp envs/.env.example envs/.env.dev      # 로컬 개발 (make dev)
#   cp envs/.env.example envs/.env.prod     # 운영     (make prod)
# 실제 값이 담긴 .env* 파일은 커밋되지 않습니다(.gitignore). 이 example만 커밋됩니다.
# =============================================================================

# --- 프로젝트 / 컨테이너 ---------------------------------------------------
# docker-compose 프로젝트명 & 네트워크명. 환경별로 다르게 두세요(dev/prod 충돌 방지).
PROJECT_NAME=myapp
NETWORK_NAME=myapp-network
APP_NAME=myapp

# --- 데이터베이스 (PostgreSQL) --------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=myapp
DB_PORT=5432
# DATABASE_URL 은 docker-compose 가 위 값들로 자동 조립합니다:
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${PROJECT_NAME}-db:5432/${POSTGRES_DB}
# 도커 없이 로컬에서 직접 api/prisma 를 돌릴 때만 아래 주석을 풀어 직접 지정하세요.
# DATABASE_URL=postgresql://postgres:change-me-strong-password@localhost:5432/myapp

# --- 포트 -----------------------------------------------------------------
# NestJS API
SERVER_PORT=3000
# Next.js Web
WEB_PORT=3001
ADMIN_PORT=3333
# dev nginx가 /admin/ 경로로 admin을 프록시하므로 admin Next 앱의 basePath를 맞춰줍니다.
# (docker-compose.dev.yaml 기본값도 /admin이라 생략해도 되지만 명시 권장)
# prod는 admin이 자체 루트에서 서빙되므로 비워두세요.
ADMIN_BASE_PATH=/admin

# --- Redis (토큰/세션 저장소) ---------------------------------------------
# 도커 실행 시 REDIS_HOST 는 compose 가 ${PROJECT_NAME}-redis 로 자동 주입합니다.
# 아래 값은 도커 없이 로컬에서 api 를 직접 돌릴 때 사용됩니다.
REDIS_HOST=localhost
REDIS_PORT=6379
# 운영(make prod)에서는 필수. dev 는 비워두면 비밀번호 없이 동작합니다.
REDIS_PASSWORD=

# --- 리버스 프록시 (nginx) -------------------------------------------------
# nginx conf 의 server_name 에 치환되는 서비스 도메인.
# prod 의 외부 트래픽(80/443)과 TLS 인증서는 서버 공용 엣지 프록시(Caddy,
# ci/edge/)가 담당합니다. 이 도메인을 엣지 Caddyfile 에 등록해야 외부에서
# 접근할 수 있습니다 (README "운영 환경 실행" 참고).
SERVER_NAME=myapp.doyeonism.com
# 서브도메인(admin.example.com 등) 간 로그인 세션(쿠키) 공유를 위해 필수 (. 접두사 포함)
COOKIE_DOMAIN=.myapp.doyeonism.com
# 엣지 프록시와 공유하는 도커 네트워크 이름 (기본 edge)
# EDGE_NETWORK_NAME=edge
# nginx 호스트 포트 — dev 전용. prod nginx 는 호스트 포트를 열지 않습니다.
NGINX_PORT=80

# --- 백엔드(API) ----------------------------------------------------------
WEB_URL=http://localhost:3001
# CORS 허용 오리진 (쉼표 구분). 비워두면 전부 차단됩니다.
# 테넌트 서브도메인 origin 은 `*` 와일드카드 한 번으로 표현합니다(예: https://*.myapp.doyeonism.com).
# 로컬에서 lvh.me/*.localhost 로 서브도메인을 시험하려면 아래처럼 포트별 와일드카드를 추가하세요
# (docs/local-tenant-dev.md 참고).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3333,http://*.lvh.me:3001,http://*.lvh.me:3333,http://*.localhost:3001,http://*.localhost:3333

# JWT 시크릿 — 운영에서는 반드시 아래 명령으로 새로 발급해서 교체하세요:
#   openssl rand -hex 32
ACCESS_JWT_SECRET=replace-with-openssl-rand-hex-32
ACCESS_JWT_EXPIRED_SEC=30*60
REFRESH_JWT_SECRET=replace-with-openssl-rand-hex-32
REFRESH_JWT_EXPIRED_SEC=30*24*60*60
SIGN_UP_JWT_SECRET=replace-with-openssl-rand-hex-32
SIGN_UP_JWT_EXPIRED_SEC=30*60

# --- 프론트엔드(Web) ------------------------------------------------------
# 컨테이너 내부에서 API 를 부를 때(서버 사이드): 도커 서비스명 사용
API_BASE_URL=http://myapp-server:3000
# 브라우저에서 API 를 부를 때(클라이언트 사이드): 외부에서 접근 가능한 주소
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# axios 인터셉터의 프로젝트 식별자(선택)
NEXT_PUBLIC_PROJECT_NAME=myapp
# 개발용 이메일 + 비밀번호 로그인 폼을 로그인 화면에 노출합니다.
# `next dev` 로 띄우면 이 값과 무관하게 항상 켜지고, 이 값은 **빌드해서 띄우는 dev 배포**
# 에서 켜기 위한 opt-in 입니다. 운영 인증 경로는 카카오 하나이므로(job-036)
# **운영에서는 반드시 비워 두세요** — 서버 권한이 넓어지지는 않지만(`POST v1/auth/login`
# 은 원래부터 공개 엔드포인트), 운영 화면에 개발용 입구가 노출됩니다.
# NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
# 
# =============================================================================
# 선택 기능 — 사용할 때만 채우세요. 비워두면 해당 기능이 비활성화됩니다.
# =============================================================================

# --- 이메일 (Nodemailer, apps/api/src/shared/modules/mail.module.ts) -------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_USER=your-account@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM="MyApp" <no-reply@myapp.com>

# --- 파일 업로드 (Azure Blob, apps/api/src/shared/configs/azure.config.ts) --
# 연결 문자열과 컨테이너명이 모두 있어야 업로드 클라이언트가 생성됩니다.
# AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
# AZURE_STORAGE_CONTAINER_NAME=uploads
# AZURE_GAME_BLOB_CONTAINER_NAME=game-assets

# --- 결제 (토스페이먼츠, apps/api/src/shared/configs/toss.config.ts) --------
# 시크릿 키는 서버 전용입니다. 절대 클라이언트/깃에 노출하지 마세요.
# 키 발급: https://developers.tosspayments.com  (테스트 키는 test_ 로 시작)
# TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx
# 클라이언트(web)용 공개 키 — 프론트 결제창 SDK 에서 사용
# NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx

# --- 매장 개설권 임시 정책 (apps/api/src/shared/configs/seat.config.ts) --------
# true 면 카드 등록/결제 없이 개설권을 발급합니다. 결제 연동 전에 매장 개설 흐름을 끝까지
# 돌려보기 위한 임시 토글입니다. **운영에서는 반드시 꺼 두세요** — 켜면 누구나 매장을 무료로
# 열 수 있습니다. 토스 설정 여부로 자동 판단하지 않는 이유는 seat.config.ts 주석 참조.
# 켜져 있으면 부팅 로그와 발급 시점에 경고가 남고, 무료로 나간 건은
# `SELECT * FROM user_subscriptions WHERE billing_key_id IS NULL AND status='ACTIVE'` 로 찾습니다.
# ALLOW_UNPAID_TENANT_SEAT=false

# --- AI 알림장 (Claude API, apps/api/src/shared/configs/anthropic.config.ts) ---
# 하루 마감 시 아이별 알림장 문장을 생성합니다. 키가 없으면 규칙 기반 문장으로
# 자동 폴백하므로 앱은 정상 기동하고 마감도 정상 동작합니다(문장이 밋밋해질 뿐).
# 키 발급: https://platform.claude.com
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
#
# 모델은 원가를 좌우합니다. 원생 30마리 · 주3회 기준 매장 1곳의 월 요약 비용:
#   claude-opus-5 약 7,100원 / claude-sonnet-5 약 4,300원 / claude-haiku-4-5 약 1,400원
# 미지정 시 claude-opus-5.
# ANTHROPIC_MODEL=claude-sonnet-5
# 하루 마감의 동시 호출 수 (기본 4). 올리면 빨라지지만 rate limit 위험이 커집니다.
# ANTHROPIC_CONCURRENCY=4

# --- 소셜 로그인 (apps/api/src/auth/services/social-auth.service.ts) ---------
# 각 provider 개발자 콘솔에서 앱 생성 → Redirect URI 등록 → Client ID/Secret 발급.
# 값이 없으면 해당 provider 엔드포인트가 501(미설정) 을 반환합니다(앱은 정상 기동).
#
# 콜백(Redirect URI)은 아래 형식이며 콘솔에 '정확히 동일하게' 등록해야 합니다:
#   {API_PUBLIC_URL}/api/{PROJECT_NAME}/v1/auth/social/{provider}/callback
#   예: http://localhost:3000/api/myapp/v1/auth/social/kakao/callback
# CALLBACK_URL 을 직접 지정하지 않으면 API_PUBLIC_URL 로 위 형식을 자동 조립합니다.
#
# 브라우저에서 접근 가능한 API 주소(콜백 조립용). 미지정 시 http://localhost:{SERVER_PORT}.
# API_PUBLIC_URL=http://localhost:3000
# 로그인 성공/실패 후 이동할 web 주소(미지정 시 WEB_URL / WEB_URL/auth/login).
# SOCIAL_LOGIN_SUCCESS_REDIRECT=http://localhost:3001
# SOCIAL_LOGIN_FAILURE_REDIRECT=http://localhost:3001/auth/login?error=social
#
# 카카오 — https://developers.kakao.com  (CLIENT_ID = REST API 키. SECRET 은 사용 설정 시)
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_CALLBACK_URL=
#
# 네이버 — https://developers.naver.com
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# NAVER_CALLBACK_URL=
#
# 디스코드 — https://discord.com/developers/applications
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_CALLBACK_URL=

# --- 최초 관리자 시드 (pnpm --filter database db:seed 로 1회 생성/승격) ----------
# ADMIN 전용 API 만으로는 첫 관리자를 만들 수 없어 아래 값으로 부트스트랩합니다.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NICKNAME=admin

# 이미지 변환 동시 실행 수 (job-053). HEIC→WebP 변환은 CPU 바운드라 코어 수를 넘겨
# 띄우면 처리량은 그대로인 채 장당 지연만 커진다(4코어 실측: 동시 3에서 2.4초, 15에서 10초).
# 기본 3 — API·웹·DB 가 같은 코어를 쓰므로 여유를 남긴다. 변환 전용 워커로 분리하면 코어 수로.
IMAGE_CONVERT_CONCURRENCY=3

# job-059: 매장 찾기 지도 (카카오).
#   KAKAO_REST_API_KEY   — 서버가 주소를 좌표로 바꿀 때(로컬 API). 미지정 시 KAKAO_CLIENT_ID 사용.
#   NEXT_PUBLIC_KAKAO_JS_KEY — 브라우저가 지도를 그릴 때(JavaScript 키). REST 키와 **다른 값**이다.
# ⚠️ 카카오 개발자 콘솔에서 [내 애플리케이션] > [카카오맵] 을 켜야 둘 다 동작한다
#    (꺼져 있으면 403 NotAuthorizedError: disabled OPEN_MAP_AND_LOCAL service).
# KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

# --- 알림 발송: Solapi (apps/api/src/shared/configs/solapi.config.ts) --------
# 이 서비스의 **전달 경로 전체**입니다. 등하원 알림·알림장·이용권 잔여·리마인드가
# 전부 여기로 나갑니다. 미설정이면 앱은 정상 기동하지만 알림이 하나도 나가지 않고,
# 실패가 NotificationLog(status=FAILED)에만 쌓여 조용히 누락됩니다.
#
# 발급: https://solapi.com  (콘솔 > 개발/연동 > API Key)

# [필수 3개] 이 셋이 모두 있어야 SMS 가 나갑니다 (isConfigured).
#   하나라도 비면 발송 함수가 아예 진입하지 않습니다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 발신번호 — 숫자만 (하이픈·공백 없이). 예: 0212345678 / 01012345678
#   ⚠️ 콘솔에 **사전 등록 + 통신사 확인**을 마친 번호만 쓸 수 있습니다(발신번호 변작 방지,
#      전기통신사업법). 등록에 시간이 걸리므로 이 절차가 알림 기능의 실제 리드타임입니다.
#   ⚠️ 코드는 이 값을 정규화하지 않고 그대로 API 에 넘깁니다 — 하이픈을 넣으면 발송이 실패합니다.
SOLAPI_SENDER_PHONE=

# [알림톡용 7개] 여기부터는 카카오 알림톡을 쓸 때만 필요합니다.
#   SMS 만 쓸 거면(예: OTP) 위 3개로 충분하고, 아래는 비워 두면 SMS 로만 나갑니다.
#
#   ⚠️ 알림톡은 **발신프로필 등록 + 템플릿 사전심사**를 통과해야 발송됩니다.
#      심사 전에는 알림톡 시도가 실패하고 SMS 로 폴백합니다(의도된 동작).
#
# 카카오 채널(플러스친구) pfId — 없으면 알림톡을 시도조차 하지 않습니다.
SOLAPI_KAKAO_PF_ID=
# 심사 통과한 템플릿 코드. 미지정 시 더미 코드(PAWLOG_*)가 쓰이는데 실제 발송은 실패합니다.
SOLAPI_TEMPLATE_CHECK_IN=
SOLAPI_TEMPLATE_CHECK_OUT_REPORT=
SOLAPI_TEMPLATE_REMAINING_COUNT_LOW=
SOLAPI_TEMPLATE_RESERVATION_REMINDER=
SOLAPI_TEMPLATE_FEED_POST=
# job-060: 임시 휴무로 그 날 등원이 취소됐음을 보호자에게 알린다.
SOLAPI_TEMPLATE_TENANT_CLOSURE=

# job-042: 휴대폰 본인확인(OTP). 전화번호는 이 서비스에서 소유권의 열쇠라
# (그 번호로 등록된 원생·알림장·사진이 넘어온다) 자기신고를 그대로 믿으면 안 된다.
# 아래는 전부 선택 — 기본값(5분/10분/5회/30초/일10회)으로 동작한다.
# OTP_TTL_SEC=300
# OTP_VERIFIED_TTL_SEC=600
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SEC=30
# OTP_DAILY_LIMIT=10
#
# ⚠️ 임시 탈출구 — true 면 본인확인 없이 번호를 저장한다(발신번호 등록 전 로컬 확인용).
#    켜져 있는 동안 남의 번호로 그 아이의 알림장·사진에 접근할 수 있다. 부팅마다 경고가 뜬다.
# ALLOW_UNVERIFIED_PHONE=false
