# =============================================================================
# .env.example — 이 파일을 복사해서 환경별 파일을 만드세요.
#   cp envs/.env.example envs/.env.dev      # 로컬 개발 (make dev)
#   cp envs/.env.example envs/.env.prod     # 운영     (make prod)
# 실제 값이 담긴 .env* 파일은 커밋되지 않습니다(.gitignore). 이 example만 커밋됩니다.
# =============================================================================

# --- 프로젝트 / 컨테이너 ---------------------------------------------------
# docker-compose 프로젝트명 & 네트워크명. 환경별로 다르게 두세요(dev/prod 충돌 방지).
PROJECT_NAME=myapp
NETWORK_NAME=myapp-network
APP_NAME=myapp

# --- 데이터베이스 (PostgreSQL) --------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=myapp
DB_PORT=5432
# DATABASE_URL 은 docker-compose 가 위 값들로 자동 조립합니다:
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${PROJECT_NAME}-db:5432/${POSTGRES_DB}
# 도커 없이 로컬에서 직접 api/prisma 를 돌릴 때만 아래 주석을 풀어 직접 지정하세요.
# DATABASE_URL=postgresql://postgres:change-me-strong-password@localhost:5432/myapp

# --- 포트 -----------------------------------------------------------------
# NestJS API
SERVER_PORT=3000
# Next.js Web
WEB_PORT=3001
ADMIN_PORT=3333
# dev nginx가 /admin/ 경로로 admin을 프록시하므로 admin Next 앱의 basePath를 맞춰줍니다.
# (docker-compose.dev.yaml 기본값도 /admin이라 생략해도 되지만 명시 권장)
# prod는 admin이 자체 루트에서 서빙되므로 비워두세요.
ADMIN_BASE_PATH=/admin

# --- Redis (토큰/세션 저장소) ---------------------------------------------
# 도커 실행 시 REDIS_HOST 는 compose 가 ${PROJECT_NAME}-redis 로 자동 주입합니다.
# 아래 값은 도커 없이 로컬에서 api 를 직접 돌릴 때 사용됩니다.
REDIS_HOST=localhost
REDIS_PORT=6379
# 운영(make prod)에서는 필수. dev 는 비워두면 비밀번호 없이 동작합니다.
REDIS_PASSWORD=

# --- 리버스 프록시 (nginx) -------------------------------------------------
# nginx conf 의 server_name 에 치환되는 서비스 도메인.
# prod 의 외부 트래픽(80/443)과 TLS 인증서는 서버 공용 엣지 프록시(Caddy,
# ci/edge/)가 담당합니다. 이 도메인을 엣지 Caddyfile 에 등록해야 외부에서
# 접근할 수 있습니다 (README "운영 환경 실행" 참고).
SERVER_NAME=myapp.doyeonism.com
# 엣지 프록시와 공유하는 도커 네트워크 이름 (기본 edge)
# EDGE_NETWORK_NAME=edge
# nginx 호스트 포트 — dev 전용. prod nginx 는 호스트 포트를 열지 않습니다.
NGINX_PORT=80

# --- 백엔드(API) ----------------------------------------------------------
WEB_URL=http://localhost:3001
# CORS 허용 오리진 (쉼표 구분). 비워두면 전부 차단됩니다.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3333

# JWT 시크릿 — 운영에서는 반드시 아래 명령으로 새로 발급해서 교체하세요:
#   openssl rand -hex 32
ACCESS_JWT_SECRET=replace-with-openssl-rand-hex-32
ACCESS_JWT_EXPIRED_SEC=30*60
REFRESH_JWT_SECRET=replace-with-openssl-rand-hex-32
REFRESH_JWT_EXPIRED_SEC=30*24*60*60
SIGN_UP_JWT_SECRET=replace-with-openssl-rand-hex-32
SIGN_UP_JWT_EXPIRED_SEC=30*60

# --- 프론트엔드(Web) ------------------------------------------------------
# 컨테이너 내부에서 API 를 부를 때(서버 사이드): 도커 서비스명 사용
API_BASE_URL=http://myapp-server:3000
# 브라우저에서 API 를 부를 때(클라이언트 사이드): 외부에서 접근 가능한 주소
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# axios 인터셉터의 프로젝트 식별자(선택)
NEXT_PUBLIC_PROJECT_NAME=myapp
# 
# =============================================================================
# 선택 기능 — 사용할 때만 채우세요. 비워두면 해당 기능이 비활성화됩니다.
# =============================================================================

# --- 이메일 (Nodemailer, apps/api/src/shared/modules/mail.module.ts) -------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_USER=your-account@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM="MyApp" <no-reply@myapp.com>

# --- 파일 업로드 (Azure Blob, apps/api/src/shared/configs/azure.config.ts) --
# 연결 문자열과 컨테이너명이 모두 있어야 업로드 클라이언트가 생성됩니다.
# AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
# AZURE_STORAGE_CONTAINER_NAME=uploads
# AZURE_GAME_BLOB_CONTAINER_NAME=game-assets

# --- 결제 (토스페이먼츠, apps/api/src/shared/configs/toss.config.ts) --------
# 시크릿 키는 서버 전용입니다. 절대 클라이언트/깃에 노출하지 마세요.
# 키 발급: https://developers.tosspayments.com  (테스트 키는 test_ 로 시작)
# TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx
# 클라이언트(web)용 공개 키 — 프론트 결제창 SDK 에서 사용
# NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx

# --- 소셜 로그인 (apps/api/src/auth/services/social-auth.service.ts) ---------
# 각 provider 개발자 콘솔에서 앱 생성 → Redirect URI 등록 → Client ID/Secret 발급.
# 값이 없으면 해당 provider 엔드포인트가 501(미설정) 을 반환합니다(앱은 정상 기동).
#
# 콜백(Redirect URI)은 아래 형식이며 콘솔에 '정확히 동일하게' 등록해야 합니다:
#   {API_PUBLIC_URL}/api/{PROJECT_NAME}/v1/auth/social/{provider}/callback
#   예: http://localhost:3000/api/myapp/v1/auth/social/kakao/callback
# CALLBACK_URL 을 직접 지정하지 않으면 API_PUBLIC_URL 로 위 형식을 자동 조립합니다.
#
# 브라우저에서 접근 가능한 API 주소(콜백 조립용). 미지정 시 http://localhost:{SERVER_PORT}.
# API_PUBLIC_URL=http://localhost:3000
# 로그인 성공/실패 후 이동할 web 주소(미지정 시 WEB_URL / WEB_URL/auth/login).
# SOCIAL_LOGIN_SUCCESS_REDIRECT=http://localhost:3001
# SOCIAL_LOGIN_FAILURE_REDIRECT=http://localhost:3001/auth/login?error=social
#
# 카카오 — https://developers.kakao.com  (CLIENT_ID = REST API 키. SECRET 은 사용 설정 시)
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_CALLBACK_URL=
#
# 네이버 — https://developers.naver.com
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# NAVER_CALLBACK_URL=
#
# 디스코드 — https://discord.com/developers/applications
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_CALLBACK_URL=

# --- 최초 관리자 시드 (pnpm --filter database db:seed 로 1회 생성/승격) ----------
# ADMIN 전용 API 만으로는 첫 관리자를 만들 수 없어 아래 값으로 부트스트랩합니다.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NICKNAME=admin
