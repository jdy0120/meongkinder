# =============================================================================
# .env.test — 테스트 실행용 더미 환경변수.
# 실제 시크릿이 아니며, env 검증(apps/api/src/shared/configs/env.ts)을 통과시키기
# 위한 최소 값입니다. jest 가 이 파일을 로드하려면 별도 setup 이 필요합니다
# (예: jest setupFiles 에서 dotenv 로 이 경로 로드).
# =============================================================================

NODE_ENV=test
PROJECT_NAME=template-test

# JWT 시크릿 (더미, 32자 이상)
ACCESS_JWT_SECRET=86283a47c1e279c86790d0e907b9f78644e918569f8934fb4a368a07c7be8b7e
ACCESS_JWT_EXPIRED_SEC=30*60
REFRESH_JWT_SECRET=0de5b2fa86aa38369705e05820f2dd40e0b39e2f6d7bc17e008fb7eb399ef2cf
REFRESH_JWT_EXPIRED_SEC=30*24*60*60
SIGN_UP_JWT_SECRET=47accf0e2dfe58a0a0009bbfcced177b5a19399414f73be1fc7c381a06113956
SIGN_UP_JWT_EXPIRED_SEC=30*60

# Database — e2e 테스트 컨테이너(docker-compose.test.yaml, 포트 5433)를 가리킴.
# 유닛 테스트는 prisma 를 목킹하므로 이 값을 실제로 연결하지 않고 검증만 통과시킴.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/template_test

# Redis — e2e 테스트 컨테이너(포트 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
