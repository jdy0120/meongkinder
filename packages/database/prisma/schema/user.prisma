// job-033: 회원은 플랫폼 전역 정체성이 되었고, 테넌트 소속은 TenantMembership 으로 분리됐다.
// - 어느 테넌트에도 속하지 않은 회원이 존재할 수 있다 (자기 펫만 관리하는 개인 보호자).
// - 한 회원이 여러 테넌트에 서로 다른 자격(TENANT_ADMIN/STAFF/GUARDIAN)으로 소속될 수 있다.
model User {
  id        String  @id @default(uuid())
  nickname  String
  // 플랫폼 전역 유니크. 테넌트별 중복 가입 개념이 사라졌다(회원 1명 = 계정 1개).
  email     String  @unique

  // 휴대폰 번호 (job-034). 숫자만 정규화해 저장한다("010-1234-5678" -> "01012345678").
  // 유치원이 미가입 보호자를 전화번호로 초대해 두면, 그 번호로 가입하는 순간
  // TenantInvitation 과 자동 매칭되므로 조회 경로가 필요하다.
  // 아직 유니크는 아니다 — 기존 계정에 번호가 없고 본인인증 절차도 없기 때문.
  phone     String?

  /**
   * 프로필 사진 (job-063). `File.id` 를 가리키는 값만 두고 관계는 걸지 않는다 —
   * `Pet.profileImageFileId` 와 같은 규칙이다.
   *
   * ⚠️ 이 파일은 **테넌트 소유가 아니다**(`FileOwnership.shared`, job-055). 회원은 여러
   * 매장에 걸치거나 아무 데도 속하지 않으므로, 업로드한 요청의 스코프로 파일 테넌트를
   * 정하면 다른 스코프에서 열 때 404 가 난다.
   */
  profileImageFileId String? @map("profile_image_file_id")

  // 플랫폼 레벨 역할만 보관: "USER" | "SUPER_ADMIN". @pawlog/shared 의 PLATFORM_ROLES 와 일치.
  // 테넌트 안에서의 역할(TENANT_ADMIN/STAFF/GUARDIAN)은 TenantMembership.role 이 갖는다.
  role      String @default("USER")
  // bcrypt 해시된 비밀번호 (소셜 전용 계정은 없을 수 있어 nullable)
  password  String?
  // 계정 상태: "ACTIVE" | "PENDING" | "SUSPENDED" (checkauth 레이아웃에서 사용)
  status    String @default("ACTIVE")

  // 인증 토큰(access/refresh)과 OTP 는 DB 가 아닌 Redis 에서 관리합니다.
  // (apps/api/src/auth/services/auth.service.ts + shared/redis)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  socialAccounts SocialAccount[]
  userInfo UserInfo?
  orders            Order[]
  termsAgreements   UserTermsAgreement[]
  pets                 Pet[]
  memberships          TenantMembership[]
  // job-034: 매장 개설권 구독 (원생 이용권과 달리 회원이 직접 결제한다)
  billingKey           UserBillingKey?
  userSubscriptions    UserSubscription[]
  dailyReportsAuthored DailyReport[]        @relation("DailyReportAuthor")
  feedPostsAuthored    FeedPost[]           @relation("FeedPostAuthor")
  subscriptionLedgers  SubscriptionLedger[]
  notificationLogs     NotificationLog[]

  @@index([phone])
  @@map("users")
}

/**
 * 회원의 테넌트 소속 (job-033).
 *
 * 한 회원이 여러 테넌트에 각기 다른 자격으로 속할 수 있다 — 예를 들어 A유치원의 STAFF 이면서
 * B유치원에는 자기 강아지를 맡긴 GUARDIAN 일 수 있다. 그래서 역할은 User 가 아니라 이 조인
 * 테이블이 갖는다.
 *
 * 활성 테넌트는 요청의 서브도메인/`X-Tenant-Id` 헤더로 정해지고, TenantMiddleware 가 그 테넌트에
 * 대한 ACTIVE 멤버십을 확인한 뒤에야 ALS 컨텍스트를 연다. JWT 는 더 이상 tenantId 를 담지 않는다.
 */
model TenantMembership {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // 이 테넌트 안에서의 역할: "TENANT_ADMIN" | "STAFF" | "GUARDIAN".
  // @pawlog/shared 의 MEMBERSHIP_ROLES 와 일치한다.
  role String

  // "PENDING"(보호자 가입 신청, 관리자 승인 대기) | "ACTIVE"(정상) | "REJECTED"(반려) | "LEFT"(탈퇴)
  // PENDING/REJECTED/LEFT 는 테넌트 리소스에 접근할 수 없다 — ACTIVE 만 통과한다.
  status String @default("PENDING")

  approvedAt DateTime? @map("approved_at")
  // 승인/반려를 처리한 관리자. 감사 추적용이라 관리자가 탈퇴해도 기록은 남긴다.
  approvedBy String?   @map("approved_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

model UserInfo {
  id   String @id @default(uuid())
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId])
  @@index([userId])
  @@map("user_infos")
}

model SocialAccount {
  id                String @id @default(uuid())
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  provider          String // "KAKAO" | "NAVER" | "DISCORD" (@pawlog/shared SOCIAL_PROVIDERS 와 일치)
  providerAccountId String // provider 가 준 고유 id. 항상 string (카카오 숫자 id 도 문자열로 저장)

  // ── 유저별 소셜 토큰 (로그인 용도에는 불필요) ──────────────────────────────
  // 알림톡 등 "사업자/봇 자격" 발송은 SaaS 키(env) 로 처리하므로 유저별 토큰이 필요 없다.
  // 나중에 "유저 카카오톡 직접 메시지 / 친구목록 / 디스코드 서버 자동가입" 등
  // 유저 본인 자격의 소셜 API 호출이 필요해지면 아래 주석을 해제하고 migrate 한다.
  // accessToken           String?   // 소셜 액세스 토큰
  // accessTokenExpiresAt  DateTime? // 액세스 토큰 만료일
  // refreshToken          String?   // 소셜 리프레시 토큰
  // refreshTokenExpiresAt DateTime? // 리프레시 토큰 만료일

  // ── provider 별 raw 프로필 스냅샷 (선택) ──────────────────────────────────
  // provider 마다 응답 구조가 다른 원본을 통째로 보관하고 싶을 때 사용. Postgres 에선 JSONB 로 매핑됨.
  // 정규화된 식별 필드는 이미 User/컬럼에 저장하므로 로그인 용도에는 불필요. 필요 시 주석 해제.
  // profile Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("social_accounts")
}