model User {
  id        String @id @default(uuid())
  nickname  String
  email     String

  // 역할: "USER"(서비스만) | "ADMIN"(서비스+관리자). @template/shared 의 ROLES 와 일치
  role      String @default("USER")
  // bcrypt 해시된 비밀번호 (소셜 전용 계정은 없을 수 있어 nullable)
  password  String?
  // 계정 상태: "ACTIVE" | "PENDING" | "SUSPENDED" (checkauth 레이아웃에서 사용)
  status    String @default("ACTIVE")

  // 인증 토큰(access/refresh)과 OTP 는 DB 가 아닌 Redis 에서 관리합니다.
  // (apps/api/src/auth/services/auth.service.ts + shared/redis)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  socialAccounts SocialAccount[]
  userInfo UserInfo?
  pointTransactions PointTransaction[]
  orders            Order[]
  billingKey        BillingKey?
  subscriptions     UserSubscription[]

  @@unique([email])
  @@map("users")
}

model UserInfo {
  id String @id @default(uuid())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId])
  @@index([userId])
  @@map("user_infos")
}


// 포인트 변동 내역 모델 신설
model PointTransaction {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  amount    Int      // 변동 금액 (충전: +, 사용: -)
  type      String   // 종류 (CHARGE, USE, REFUND 등)
  description String? // 상세 내용
  
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId])
  @@map("point_transactions")
}

model SocialAccount {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  provider  String
  accountId String
  
  // 추가해야 할 컬럼들
  accessToken        String?  // 카카오 액세스 토큰
  accessTokenExpiresAt DateTime? // 액세스 토큰 만료일
  refreshToken       String?  // 카카오 리프레시 토큰
  refreshTokenExpiresAt DateTime? // 리프레시 토큰 만료일
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([provider, accountId])
  @@index([userId])
  @@map("social_accounts")
}