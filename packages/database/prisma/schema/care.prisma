// 출석(등/하원) 및 일일 리포트 도메인

model Attendance {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  date       DateTime  @db.Date // 출석 대상 일자
  checkInAt  DateTime? @map("check_in_at")
  checkOutAt DateTime? @map("check_out_at")

  // SCHEDULED(예약) | CHECKED_IN(등원) | CHECKED_OUT(하원) | ABSENT(결석) | MAKEUP(보강) | CANCELED(취소)
  status String @default("SCHEDULED")

  ledger      SubscriptionLedger?
  dailyReport DailyReport?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([petId, date])
  @@index([petId])
  @@index([date])
  @@index([tenantId])
  @@map("attendances")
}

model DailyReport {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  attendanceId String?     @unique @map("attendance_id")
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])

  authorId String? @map("author_id") // 작성자(관리자/스태프) User id
  author   User?   @relation("DailyReportAuthor", fields: [authorId], references: [id])

  date    DateTime @db.Date
  summary String? // 총평/한줄 요약

  // 입력된 리포트 항목 기반 AI 코멘트 초안 (규칙 기반 자동 생성, 스태프가 검수 후 summary 로 확정)
  aiCommentDraft String? @map("ai_comment_draft")

  // DRAFT(작성중) | PUBLISHED(발행/보호자 공개)
  status String @default("DRAFT")

  contents ReportContent[]

  /** 이 알림장의 사진을 피드에도 쌓아 두는 미러 게시물 (job-062). */
  mirroredFeedPost FeedPost? @relation("DailyReportMirror")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([petId])
  @@index([date])
  @@index([tenantId])
  @@map("daily_reports")
}

model ReportContent {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dailyReportId String      @map("daily_report_id")
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  // 항목 구분: MEAL(식사) | TOILET(배변) | NAP(낮잠) | ACTIVITY(활동) | HEALTH(건강) | NOTE(특이사항) | PHOTO(사진)
  type    String
  title   String?
  content String?

  fileId String? @map("file_id")
  file   File?   @relation(fields: [fileId], references: [id])

  order Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dailyReportId])
  @@index([tenantId])
  @@map("report_contents")
}
