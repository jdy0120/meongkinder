// 결제 도메인 (토스페이먼츠)
//
// status 값은 기존 스키마 컨벤션(String)을 따릅니다. 허용 값은 아래 주석 및
// apps/api/src/payment/constants.ts 의 상수와 일치시켜 사용하세요.

model Order {
  id        String @id @default(uuid())
  // 우리 서버가 생성하는 주문 식별자(토스에 넘기는 orderId). 6~64자.
  orderId   String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderName String // 결제창에 노출되는 주문명 (예: "포인트 10,000원 충전")
  amount    Int // 결제 금액 (원, KRW)

  // PENDING(주문생성) | PAID(승인완료) | CANCELED(취소) | FAILED(실패)
  status     String  @default("PENDING")
  failReason String? @map("fail_reason") // 결제 실패 사유

  payment   Payment?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([userId])
  @@map("orders")
}

model Payment {
  id         String @id @default(uuid())
  // 토스가 발급하는 결제 키
  paymentKey String @unique
  // Order.orderId 와 1:1 매핑
  orderId    String @unique
  order      Order  @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  method     String? // 카드 | 가상계좌 | 간편결제 등 (토스 응답)
  amount     Int // 실제 승인 금액
  // 토스 결제 상태: READY | IN_PROGRESS | WAITING_FOR_DEPOSIT | DONE
  //             | CANCELED | PARTIAL_CANCELED | ABORTED | EXPIRED
  status     String

  approvedAt DateTime? // 승인 시각
  // 토스 응답 원본 보관 (취소 내역/영수증 등 추후 조회용)
  rawData    Json?

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")

  @@map("payments")
}
