model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String   // 플랜 이름 (예: "BASIC 요금제")
  price       Int      // 결제 금액 (원, KRW)
  interval    String   // 결제 주기 (MONTHLY, YEARLY)
  description String?

  subscriptions UserSubscription[]
  createdAt   DateTime @default(now()) @map("created_at")
  @@map("subscription_plans")
}

// 정기권/회수권 사용 및 잔여 횟수 변동 내역 (충전/차감/환불/소멸 원장)
model SubscriptionLedger {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   UserSubscription? @relation(fields: [subscriptionId], references: [id])

  attendanceId String?     @unique @map("attendance_id")
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])

  // CHARGE(충전) | USE(사용/차감) | REFUND(환불/복구) | EXPIRE(소멸)
  type         String
  amount       Int // 변동 횟수 (차감: 음수, 충전: 양수)
  balanceAfter Int @map("balance_after") // 변동 후 잔여 횟수
  description  String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([subscriptionId])
  @@map("subscription_ledgers")
}

model BillingKey {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  customerKey    String   @unique // 토스페이먼츠용 고객 식별 키
  billingKey     String   // PG사에서 발급받은 실제 빌링키
  
  cardName       String?  // 카드사 이름 (마이페이지 노출용)
  cardNumber     String?  // 마스킹된 카드 번호 (마이페이지 노출용)

  subscriptions  UserSubscription[]
  createdAt      DateTime @default(now()) @map("created_at")
  @@map("billing_keys")
}

model UserSubscription {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  
  billingKeyId    String?
  billingKey      BillingKey?      @relation(fields: [billingKeyId], references: [id])

  // ACTIVE(활성) | CANCELED(해지예정) | EXPIRED(만료) | FAIL_PAUSED(결제실패 보류)
  status          String           @default("ACTIVE")
  
  startDate       DateTime         @map("start_date") // 구독 시작일
  endDate         DateTime         @map("end_date")   // 구독 만료일
  nextPaymentDate DateTime         @map("next_payment_date") // 다음 정기결제 예정일

  ledgers         SubscriptionLedger[]

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_subscriptions")
}
