model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String   // 플랜 이름 (예: "BASIC 요금제", "10회권", "월 무제한", "호텔 1박권")
  price       Int      // 결제 금액 (원, KRW)
  interval    String   // 결제 주기 (MONTHLY, YEARLY) — planType=RECURRING 에서만 사용
  description String?

  // RECURRING(기존 정기결제/자동갱신) | COUNT(횟수제 회수권, 예: 10회권) | UNLIMITED(기간 내 무제한, 예: 월 무제한) | PERIOD(단기 기간제, 예: 호텔 1박권)
  planType     String   @default("RECURRING") @map("plan_type")
  totalCount   Int?     @map("total_count") // COUNT/PERIOD 유형의 총 제공 횟수 (예: 10회권=10, 호텔1박권=1)
  validityDays Int?     @map("validity_days") // 구매일로부터 유효기간(일). RECURRING 이 아닌 유형은 필수
  isActive     Boolean  @default(true) @map("is_active") // 판매 활성화 여부 (soft delete)

  /**
   * 이 요금제가 무엇을 파는지 (job-034).
   *
   *   "TENANT"   — 원생 이용권. 보호자가 특정 유치원에서 결제하는 10회권/월 무제한/호텔 1박권 등.
   *                구매 결과는 TenantSubscription 이고, 사용 내역은 SubscriptionLedger 가 기록한다.
   *   "PLATFORM" — 매장 개설권. 회원이 pawlog 에 직접 결제하는 SaaS 요금으로, 1건당 테넌트 1개를
   *                개설할 수 있다. 구매 결과는 UserSubscription 이다.
   *
   * 두 상품이 한 테이블에 섞여 있으므로 목록 조회 시 반드시 scope 로 걸러야 한다.
   */
  scope String @default("TENANT")

  /**
   * 이 요금제를 파는 유치원 (job-051).
   *
   * `scope` 와 짝을 이루는 필드다:
   *   - scope="TENANT"   ⇒ tenantId **필수**. 요금제는 그 유치원의 상품이다.
   *   - scope="PLATFORM" ⇒ tenantId **null**. 개설권은 pawlog 가 파는 상품이라 주인이 없다.
   * 이 규칙은 DB CHECK 제약(`subscription_plans_scope_tenant_ck`)으로도 굳혀 두었다 —
   * 둘 중 하나만 맞춰 넣는 실수가 이 테이블에서는 곧 **다른 유치원에 상품이 새는 사고**라
   * 애플리케이션 검증만으로는 부족하다.
   *
   * ⚠️ 이 모델은 Prisma 테넌트 스코프 확장(TENANT_SCOPED_MODELS)에 **넣지 않았다**.
   * 개설권 조회(`v1/platform-subscriptions/plans`)는 테넌트 컨텍스트 밖에서 도는데,
   * 자동 주입 대상이 되면 그 경로에서 tenantId=null 인 개설권이 조회되지 않는다.
   * 대신 서비스가 명시적으로 where 에 tenantId 를 넣는다.
   */
  tenantId String? @map("tenant_id") @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  subscriptions     TenantSubscription[]
  userSubscriptions UserSubscription[]
  sales             TenantSale[]
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([scope, isActive])
  // 유치원의 판매 중인 요금제 목록이 가장 잦은 조회다.
  @@index([tenantId, scope, isActive])
  @@map("subscription_plans")
}

/**
 * 회원 소유 빌링키 (job-034).
 *
 * 매장 개설권은 테넌트가 생기기 **전에** 결제해야 하므로 빌링키가 테넌트에 매여 있으면 안 된다.
 * (TenantBillingKey 는 원생 이용권 결제용으로 그대로 남는다)
 */
model UserBillingKey {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerKey String @unique @map("customer_key") // 토스페이먼츠용 고객 식별 키
  billingKey  String @map("billing_key") // PG사에서 발급받은 실제 빌링키

  cardName   String? @map("card_name") // 카드사 이름 (마이페이지 노출용)
  cardNumber String? @map("card_number") // 마스킹된 카드 번호 (마이페이지 노출용)

  subscriptions UserSubscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_billing_keys")
}

/**
 * 회원의 매장 개설권 구독 (job-034) — 구독 1건 = 매장 1개.
 *
 * 토스페이먼츠 결제가 성사되면 tenantId 가 비어 있는 상태로 발급되고("미사용 개설권"),
 * 온보딩이 그중 하나를 소비해 tenantId 를 채운다. tenantId 가 @unique 이므로 하나의 구독으로
 * 두 매장을 열 수 없다. 2호점을 내려면 구독을 하나 더 결제해야 한다.
 *
 * 구독이 만료/해지되면 연결된 테넌트를 isActive=false 로 정지시킨다(스케줄러).
 */
model UserSubscription {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String           @map("plan_id")
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  billingKeyId String?         @map("billing_key_id")
  billingKey   UserBillingKey? @relation(fields: [billingKeyId], references: [id])

  // 이 개설권으로 만든 매장. null 이면 아직 쓰지 않은 개설권이다.
  tenantId String? @unique @map("tenant_id") @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  // ACTIVE(활성) | CANCELED(해지예정) | EXPIRED(만료) | FAIL_PAUSED(결제실패 보류)
  status String @default("ACTIVE")

  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  nextPaymentDate DateTime @map("next_payment_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, status])
  @@map("user_subscriptions")
}

// 정기권/회수권 사용 및 잔여 횟수 변동 내역 (충전/차감/환불/소멸 원장)
model SubscriptionLedger {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /**
   * 이용권의 주인 = **아이** (job-045).
   *
   * 예전에는 잔액을 `userId` 로 체인했는데, 그 전제가 두 군데서 깨졌다:
   *   1. 매장이 전화번호만으로 등록한 원생은 계정이 없다(job-040). 도입 첫날엔 원생 전원이
   *      그 상태라, 회원 기준 원장은 **아무것도 차감하지 못했다**.
   *   2. 형제견을 맡기는 보호자는 이용권을 아이마다 산다. 회원 기준이면 두 마리가 한 지갑을
   *      나눠 쓰게 되어 "초코 10회권"과 "두부 10회권"을 구분할 수 없다.
   *
   * 파는 단위가 아이이므로 원장(ledger)도 아이 단위다. 계정 연결 여부와 무관하게 돌아간다.
   */
  petId String @map("pet_id")
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  /**
   * 그 시점의 보호자 계정 (있으면). 잔액 계산에는 쓰지 않고 **누구에게 청구/안내했는지**를
   * 남기는 감사 정보다. 계정 없이 등록된 원생은 null.
   */
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  subscriptionId String?
  subscription   TenantSubscription? @relation(fields: [subscriptionId], references: [id])

  attendanceId String?     @unique @map("attendance_id")
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])

  // CHARGE(충전) | USE(사용/차감) | REFUND(환불/복구) | EXPIRE(소멸)
  type         String
  amount       Int // 변동 횟수 (차감: 음수, 충전: 양수)
  balanceAfter Int @map("balance_after") // 변동 후 잔여 횟수
  description  String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  // 잔액 계산이 "이 아이의 마지막 원장 1건"을 읽으므로 이 조합이 핵심 인덱스다.
  @@index([petId, createdAt])
  @@index([userId])
  @@index([subscriptionId])
  @@map("subscription_ledgers")
}

// 테넌트(가맹점)의 토스페이먼츠 빌링키 — 구독은 개별 유저가 아닌 테넌트 단위로 결제됩니다.
model TenantBillingKey {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerKey    String   @unique // 토스페이먼츠용 고객 식별 키
  billingKey     String   // PG사에서 발급받은 실제 빌링키

  cardName       String?  // 카드사 이름 (마이페이지 노출용)
  cardNumber     String?  // 마스킹된 카드 번호 (마이페이지 노출용)

  subscriptions  TenantSubscription[]
  createdAt      DateTime @default(now()) @map("created_at")
  @@map("tenant_billing_keys")
}

// 테넌트(가맹점) 단위 정기권/회수권 구독 — B2B 과금 모델 전환에 따라 주체가 User → Tenant 로 이동.
model TenantSubscription {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id") @db.Uuid
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])

  /**
   * 이 이용권의 주인 = **아이** (job-051).
   *
   * job-045 가 잔액(SubscriptionLedger)만 아이 단위로 내리고 구매는 테넌트 단위에 남겨둔
   * 탓에, "어느 아이가 어떤 이용권을 샀는지"가 어디에도 없었다. 그 결과 출석 차감이
   * `findFirst({ status: "ACTIVE" })` 로 **그 매장의 가장 최근 구독 1건**을 집어
   * 전체 원생의 차감 규칙을 정해버렸다 — 일권과 한달권을 같이 파는 순간 둘 중 하나는
   * 반드시 틀린다(한달권이 최근이면 일권 아이가 공짜로 다니고, 일권이 최근이면
   * 한달권 아이가 -1씩 깎이다 "잔여 없음" 알림까지 받는다).
   *
   * 파는 단위가 아이이므로 구매 기록도 아이를 가리킨다. 잔액(SubscriptionLedger.petId)과
   * 같은 축이라 이제 둘이 어긋나지 않는다.
   */
  // @map 을 붙이는 이유: 이 테이블은 planId/billingKeyId 가 camelCase 컬럼인데,
  // 같은 "아이"를 가리키는 subscription_ledgers 는 pet_id(snake) 다. 손으로 조인을 쓸 때
  // 같은 뜻의 컬럼 이름이 테이블마다 다르면 반드시 틀린다 — 새 컬럼은 snake 로 맞춘다.
  petId           String?          @map("pet_id")
  pet             Pet?             @relation(fields: [petId], references: [id], onDelete: Cascade)

  billingKeyId    String?
  billingKey      TenantBillingKey? @relation(fields: [billingKeyId], references: [id])

  // ACTIVE(활성) | CANCELED(해지예정) | EXPIRED(만료) | FAIL_PAUSED(결제실패 보류) | PAUSED(일시정지/휴회)
  status          String           @default("ACTIVE")
  pausedAt        DateTime?        @map("paused_at") // 일시정지(휴회) 시작 시각

  startDate       DateTime         @map("start_date") // 구독 시작일
  endDate         DateTime         @map("end_date")   // 구독 만료일
  nextPaymentDate DateTime         @map("next_payment_date") // 다음 정기결제 예정일

  ledgers         SubscriptionLedger[]
  sales           TenantSale[]

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([tenantId])
  // 출석 차감이 "이 아이의 활성 이용권"을 찾는 경로 — 가장 잦은 조회다.
  @@index([petId, status])
  @@map("tenant_subscriptions")
}

/**
 * 유치원 매출 원장 (job-051).
 *
 * **입금 기준(현금주의)** 이다 — 10회권 20만원을 3월에 팔면 3월 매출 20만원이고, 4월에
 * 다 쓰더라도 4월 매출은 0이다. 사용자 결정이며, 원장이 통장을 보는 방식과 같아서
 * 설명이 필요 없다는 게 이유다. (이용 기준으로 바꾸려면 SubscriptionLedger 의 USE 로우에
 * 단가를 곱해 집계하는 별도 경로가 필요하다 — 이 테이블은 건드리지 않아도 된다.)
 *
 * ## 왜 Payment 를 그대로 쓰지 않았나
 *
 * `Payment` 는 **토스 결제 기록**이다(`paymentKey` 유니크, 토스 응답 원본 보관). 현장에서
 * 현금으로 받은 20만원에 가짜 `paymentKey` 를 넣으면 그 테이블이 더 이상 PG 대사에 쓸 수
 * 없게 된다. 그래서 매출은 별도 원장으로 두고, 카드 판매는 `paymentId` 로 토스 기록을
 * 가리킨다 — 두 질문("얼마 벌었나" / "이 결제 뭐였나")의 답이 서로 다른 테이블에 있다.
 *
 * 정기결제 갱신도 매 건 여기에 한 줄씩 쌓인다. TenantSubscription 은 갱신 시 endDate 만
 * 갱신되고 로우가 늘지 않아, 구독 테이블만으로는 갱신 매출을 셀 수 없다.
 */
model TenantSale {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /** 어떤 상품을 팔았는지. 요금제가 삭제돼도 매출 기록은 남아야 하므로 SetNull. */
  planId String?           @map("plan_id")
  plan   SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  /** 누구의 이용권인지. 원생이 삭제돼도 매출은 남는다. */
  petId String? @map("pet_id")
  pet   Pet?    @relation(fields: [petId], references: [id], onDelete: SetNull)

  /** 이 판매로 만들어진 이용권. 갱신 매출은 같은 구독을 여러 번 가리킨다(유니크 아님). */
  subscriptionId String?             @map("subscription_id")
  subscription   TenantSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  /** 카드 결제면 토스 결제 기록. 현장 결제는 null. */
  paymentId String? @unique @map("payment_id")
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  /** 실제로 받은 금액(원). 요금제 정가와 다를 수 있다(형제 할인 등) — 매출은 받은 돈 기준이다. */
  amount Int

  // CARD(온라인 카드) | CASH(현금) | TRANSFER(계좌이체) | CARD_OFFLINE(현장 단말기)
  method String

  /** 매출 인식 시점 = 돈을 받은 시점. 월별 집계의 기준 컬럼이다. */
  soldAt DateTime @map("sold_at")

  /**
   * 환불 처리 시각 (job-054). 전액이든 부분이든 환불이 일어난 순간을 기록한다.
   *
   * 환불을 음수 매출 로우로 남기지 않는 이유는, 환불이 "판매가 없던 일이 됨"이지
   * "새로운 거래"가 아니기 때문이다 — 판매 1건에 로우 1개가 유지돼야 "몇 건 팔았나"가
   * 흐려지지 않는다.
   */
  canceledAt DateTime? @map("canceled_at")

  /**
   * 환불한 금액(원) — **부분 환불을 표현하기 위한 필드다** (job-054).
   *
   * 10회권을 팔고 3회 쓴 뒤 그만두는 경우가 실제로 흔하다. 이때 전액 취소로만 처리하면
   * 이미 제공한 3회분까지 매출에서 사라져 장부가 매장에 불리하게 틀어진다.
   *
   * 그래서 집계는 `canceledAt IS NULL` 이 아니라 **`amount - refundedAmount`** 로 한다.
   * 전액 환불이면 이 값이 `amount` 와 같아져 그 건의 매출 기여가 0이 된다.
   */
  refundedAmount Int @default(0) @map("refunded_amount")

  /** 환불 사유. 나중에 "왜 이 달 매출이 줄었나"를 설명하는 유일한 근거다. */
  refundReason String? @map("refund_reason")

  memo String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 월별 매출 집계의 주 인덱스.
  @@index([tenantId, soldAt])
  @@index([petId])
  @@map("tenant_sales")
}
